#!/usr/bin/bash
set -euo pipefail

# The per-image OBS drop-in includes mkosi-obs before registering this script,
# so the upstream helper has already staged hashes and written the follow-up
# recipe when this runs.
source_dir=
for candidate in /usr/src/packages/SOURCES/*; do
    if [[ -f ${candidate}/mkosi.final-output ]]; then
        source_dir=${candidate}
        break
    fi
done
[[ -n ${source_dir} ]] || {
    echo "mkosi source tree containing mkosi.final-output not found" >&2
    exit 1
}

shopt -s nullglob

# CompressOutput= applies to split partition artifacts as well as the complete
# disk image. They have already been compressed by mkosi when this hook runs.
usrs=("$OUTPUTDIR"/"$IMAGE_ID"_"$IMAGE_VERSION"_"$ARCHITECTURE".usr-"$ARCHITECTURE".[[:xdigit:]]*.raw.zst)
verities=("$OUTPUTDIR"/"$IMAGE_ID"_"$IMAGE_VERSION"_"$ARCHITECTURE".usr-"$ARCHITECTURE"-verity.*.raw.zst)

if (( ${#usrs[@]} != 1 )); then
    printf 'Expected one split EROFS /usr artifact for %s, found %d\n' \
        "$IMAGE_ID" "${#usrs[@]}" >&2
    printf 'Candidates: %s\n' "${usrs[*]:-<none>}" >&2
    exit 1
fi
if (( ${#verities[@]} != 1 )); then
    printf 'Expected one split usr-verity artifact for %s, found %d\n' \
        "$IMAGE_ID" "${#verities[@]}" >&2
    printf 'Candidates: %s\n' "${verities[*]:-<none>}" >&2
    exit 1
fi

disk="$OUTPUTDIR/${IMAGE_ID}_${IMAGE_VERSION}_${ARCHITECTURE}.raw.zst"
[[ -f ${disk} ]] || {
    printf 'Expected Zstd-compressed OBS disk image not found: %s\n' "$disk" >&2
    exit 1
}
recipe=${OUTPUTDIR}/mkosi.conf
[[ -f ${recipe} ]] || {
    echo "mkosi-obs did not create its second-stage recipe" >&2
    exit 1
}
install -m 0755 "${source_dir}/mkosi.final-output" "${OUTPUTDIR}/mkosi.final-output"
cat >> "${recipe}" <<'RECIPE'

[Content]
BuildScripts=%D/mkosi.final-output
RECIPE
