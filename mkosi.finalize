#!/usr/bin/bash
set -euo pipefail

root=${BUILDROOT:?}

# Packaging must retain the desktop root's exact extension compatibility level.
# Refuse a stale BaseTrees= input rather than publishing an incompatible OS.
grep -Fxq "SYSEXT_LEVEL=\"${IMAGE_ID:?}-${IMAGE_VERSION:?}\"" "${root}/usr/lib/os-release" || {
    echo 'proto: disk image and desktop build-root sysext levels differ' >&2
    exit 1
}

# mkosi-obs injects the current OBS project certificate for PE/UKI signing.
# systemd-sysupdate verifies SHA256SUMS.gpg with the corresponding public
# OpenPGP key installed by proto-signing-keys in immutable /usr.
source_dir=
for candidate in "${CHROOT_SRCDIR:?}" /usr/src/packages/SOURCES/*; do
    if [[ -f ${candidate}/mkosi.finalize && -f ${candidate}/mkosi.make-installer-addon ]]; then
        source_dir=${candidate}
        break
    fi
done
[[ -n ${source_dir} ]] || {
    echo "mkosi source tree containing the image assembly hooks not found" >&2
    exit 1
}

install -d -m 0755 "${root}/efi/EFI/BOOT"
install -m 0644 "${root}/usr/share/proto/keys/home_Tobi_Peter_proto.cer" \
    "${root}/efi/EFI/BOOT/home_Tobi_Peter_proto.cer"

# mkosi appends io.mkosi.initrd artifacts after the shared default initrd.
# Use the same os-release as the system and UKI, including its desktop ID.
"${source_dir}/mkosi.make-initrd-identity"

# Generate the desktop-specific live role as a separate unsigned PE artifact.
# OBS signs it alongside the UKI. The terminal signing stage replaces this
# copy in XBOOTLDR with the signed artifact before publishing the disk image.
addon="${OUTPUTDIR:?}/${IMAGE_ID:?}-installer.addon.efi"
"${source_dir}/mkosi.make-installer-addon" "${source_dir}" "${addon}"
# Finalize scripts run before mkosi generates the UKI, so create its companion
# directory from the same configured naming fields mkosi uses moments later.
uki="${IMAGE_ID}_${IMAGE_VERSION:?mkosi image version is required}_${ARCHITECTURE:?}.efi"
install -d -m 0755 "${root}/boot/EFI/Linux/${uki}.extra.d"
install -m 0644 "${addon}" \
    "${root}/boot/EFI/Linux/${uki}.extra.d/10-proto-installer.addon.efi"

case ${IMAGE_ID:?mkosi did not export IMAGE_ID} in
    proto-gnome) metainfo=${source_dir}/io.github.TobiPeterG.Proto.GNOME.metainfo.xml ;;
    proto-kde) metainfo=${source_dir}/io.github.TobiPeterG.Proto.KDE.metainfo.xml ;;
    *)
        echo "No AppStream metadata template for IMAGE_ID=${IMAGE_ID}" >&2
        exit 1
        ;;
esac
[[ -f ${metainfo} ]] || {
    echo "AppStream metadata source file not found: ${metainfo}" >&2
    exit 1
}

release_date=$(date --utc --date="@${SOURCE_DATE_EPOCH:?}" +%F)
image_version=${IMAGE_VERSION:?mkosi did not export IMAGE_VERSION}
image_version=$(printf '%s' "${image_version}" | sed \
    -e 's/&/\\&amp;/g' \
    -e 's/</\\&lt;/g' \
    -e 's/>/\\&gt;/g' \
    -e 's/"/\\&quot;/g' \
    -e "s/'/\\&apos;/g")
output=${OUTPUTDIR:?}/${IMAGE_ID}.metainfo.xml

if grep -Fq "<release version=\"${image_version}\"" "${metainfo}"; then
    install -m 0644 "${metainfo}" "${output}"
else
    while IFS= read -r line; do
        printf '%s\n' "${line}"
        if [[ ${line} == '  <releases>' ]]; then
            printf '%s\n' \
                "    <release version=\"${image_version}\" date=\"${release_date}\">" \
                '      <description>' \
                '        <p>This release includes general maintenance and package updates.</p>' \
                '        <ul>' \
                '          <li>Bug fixes</li>' \
                '          <li>Performance improvements</li>' \
                '          <li>Package updates</li>' \
                '        </ul>' \
                '      </description>' \
                '    </release>'
        fi
    done < "${metainfo}" > "${output}"
    chmod 0644 "${output}"
fi
