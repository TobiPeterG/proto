#!/usr/bin/bash
set -euo pipefail

# Run after mkosi-obs attached all signatures, installed the signed UKI and
# reconstructed the final artifacts. The complete disk crosses the OBS stage
# boundary as Zstd, but XZ is the sole publication format.
output_dir=${OUTPUTDIR:-${SRCDIR:?}/usr/src/packages/OTHER}

shopt -s nullglob
# Each OBS package contains one desktop image. Convert only that image's final
# partition and disk artifacts directly to XZ without materializing another
# raw copy.
zstds=("${output_dir}/${IMAGE_ID}_"*.raw.zst)
(( ${#zstds[@]} > 0 )) || {
    echo "No final Zstd artifacts found for ${IMAGE_ID} in ${output_dir}" >&2
    exit 1
}
for zstd_image in "${zstds[@]}"; do
    xz_image=${zstd_image%.zst}.xz
    temporary=${xz_image}.tmp
    rm -f -- "${temporary}"
    zstd --decompress --stdout "${zstd_image}" | \
        xz --threads=0 > "${temporary}"
    mv -f -- "${temporary}" "${xz_image}"
    rm -f -- "${zstd_image}"
done

# Be defensive if mkosi-obs produces an uncompressed split artifact in a
# future version: compress it and remove the raw file as well.
raws=("${output_dir}/${IMAGE_ID}_"*.raw)
for raw in "${raws[@]}"; do
    xz --threads=0 --force "${raw}"
done
