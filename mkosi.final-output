#!/usr/bin/bash
set -euo pipefail

# Run after each mkosi-obs signing round. The complete disk crosses OBS stage
# boundaries compressed; once all signing rounds are complete, XZ is the sole
# publication format.
output_dir=${OUTPUTDIR:-${SRCDIR:?}/usr/src/packages/OTHER}

shopt -s nullglob

# Attaching signed PCR policies changes the UKI and consequently requires a
# further OBS signing round for the resulting PE image. mkosi-obs carries its
# generated recipe forward in that case, but not additional scripts referenced
# by the recipe. Defer all final processing and carry this script forward until
# the terminal signing round has produced the final Secure Boot-signed UKI.
if [[ -f ${output_dir}/hashes.cpio.rsasign ]]; then
    recipe=${output_dir}/mkosi.conf
    [[ -f ${recipe} ]] || {
        echo "mkosi-obs requested another signing round without a recipe" >&2
        exit 1
    }

    install -m 0755 "${BASH_SOURCE[0]}" "${output_dir}/mkosi.final-output"
    if ! grep -Fxq 'BuildScripts=%D/mkosi.final-output' "${recipe}"; then
        cat >> "${recipe}" <<'RECIPE'

[Content]
BuildScripts=%D/mkosi.final-output
RECIPE
    fi

    # mkosi-obs assumes a UKI matching <name>.raw.zst belongs in that disk's
    # ESP. Proto keeps the UKI in XBOOTLDR instead. Before a UKI-only signing
    # round, hide the combined image behind a distinct hand-off name so the
    # next mkosi-obs invocation does not expand the 28 GiB disk just to look
    # for an ESP. The terminal invocation below installs the signed UKI into
    # XBOOTLDR and restores the public image name.
    # TODO(mkosi-obs): Remove this hand-off once mkosi-obs supports XBOOTLDR.
    pending_entries=()
    while IFS= read -r entry; do
        entry=${entry#./}
        [[ -n ${entry} && ${entry} != . ]] && pending_entries+=("${entry}")
    done < <(cpio --quiet -it < "${output_dir}/hashes.cpio.rsasign")

    uki_only=true
    (( ${#pending_entries[@]} > 0 )) || uki_only=false
    for entry in "${pending_entries[@]}"; do
        [[ ${entry} == ukis/*.efi ]] || uki_only=false
    done

    if ${uki_only}; then
        pending_ukis=("${output_dir}/${IMAGE_ID}_"*.efi)
        if (( ${#pending_ukis[@]} == 1 )); then
            combined_image=${pending_ukis[0]%.efi}.raw.zst
            handoff=${combined_image%.raw.zst}.combined.raw.zst
            if [[ -f ${combined_image} ]]; then
                mv -f -- "${combined_image}" "${handoff}"
                echo "Renamed combined image for UKI-only signing hand-off: ${handoff##*/}"
            fi
        else
            printf 'Expected one UKI before final signing, found %d\n' \
                "${#pending_ukis[@]}" >&2
            exit 1
        fi
    fi

    echo "Further OBS signing round pending; deferring final UKI installation"
    exit 0
fi

# mkosi-obs currently installs signed UKIs only into an ESP. Proto stores UKIs
# in XBOOTLDR, so replace the unsigned UKI there with the signed standalone
# artifact before publishing the combined image.
# TODO(mkosi-obs): Remove this disk rewrite when mkosi-obs detects XBOOTLDR and
# installs the signed UKI there itself.
ukis=("${output_dir}/${IMAGE_ID}_"*.efi)
(( ${#ukis[@]} == 1 )) || {
    printf 'Expected one signed UKI for %s, found %d\n' \
        "${IMAGE_ID}" "${#ukis[@]}" >&2
    exit 1
}
uki=${ukis[0]}
disk_raw=${uki%.efi}.raw
disk_zstd=${disk_raw}.zst
disk_xz=${disk_raw}.xz
disk_handoff=${disk_raw%.raw}.combined.raw.zst
disk_inputs=()
[[ -f ${disk_zstd} ]] && disk_inputs+=("${disk_zstd}")
[[ -f ${disk_xz} ]] && disk_inputs+=("${disk_xz}")
[[ -f ${disk_handoff} ]] && disk_inputs+=("${disk_handoff}")
(( ${#disk_inputs[@]} == 1 )) || {
    printf 'Expected one compressed combined image for %s, found %d\n' \
        "${uki}" "${#disk_inputs[@]}" >&2
    exit 1
}
disk_input=${disk_inputs[0]}

temporary=${disk_xz}.tmp
cleanup() {
    rm -f -- "${temporary}" "${disk_raw}"
}
trap cleanup EXIT

rm -f -- "${disk_raw}" "${temporary}"
case ${disk_input} in
    *.zst)
        zstd --decompress --sparse --force -o "${disk_raw}" "${disk_input}"
        ;;
    *.xz)
        xz --decompress --stdout "${disk_input}" | \
            dd of="${disk_raw}" bs=16M conv=sparse status=none
        ;;
esac

xbootldr_offset=$(systemd-repart --json=short "${disk_raw}" | jq -er '
    [.[] | select(.type == "xbootldr") | .offset]
    | if length == 1 then .[0]
      else error("expected exactly one XBOOTLDR partition")
      end
')

uki_name=$(basename "${uki}")
printf 'Installing signed UKI %s into XBOOTLDR at offset %s\n' \
    "${uki_name}" "${xbootldr_offset}"
mmd -D s -i "${disk_raw}@@${xbootldr_offset}" ::EFI ::EFI/Linux || true
mcopy -n -o -i "${disk_raw}@@${xbootldr_offset}" \
    "${uki}" "::EFI/Linux/${uki_name}"

xz --threads=0 --stdout "${disk_raw}" > "${temporary}"
[[ ${disk_input} == "${disk_xz}" ]] || rm -f -- "${disk_input}"
mv -f -- "${temporary}" "${disk_xz}"
rm -f -- "${disk_raw}"
trap - EXIT

# Convert any remaining Zstd-compressed split partition artifacts directly to
# XZ without materializing additional raw copies. Existing XZ artifacts need
# no conversion.
zstds=("${output_dir}/${IMAGE_ID}_"*.raw.zst)
for zstd_image in "${zstds[@]}"; do
    xz_image=${zstd_image%.zst}.xz
    temporary=${xz_image}.tmp
    rm -f -- "${temporary}"
    zstd --decompress --stdout "${zstd_image}" | \
        xz --threads=0 > "${temporary}"
    mv -f -- "${temporary}" "${xz_image}"
    rm -f -- "${zstd_image}"
done

# Be defensive if mkosi-obs produces an uncompressed split artifact in a
# future version: compress it and remove the raw file as well.
raws=("${output_dir}/${IMAGE_ID}_"*.raw)
for raw in "${raws[@]}"; do
    xz --threads=0 --force "${raw}"
done
