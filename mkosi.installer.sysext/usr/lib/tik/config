# Directory for users to add custom configuration and modules
# Default: "/etc/tik"
TIK_CUSTOM_DIR="/etc/tik"

# image selection; an empty directory selects self-deployment.
TIK_IMG_DIR="/usr/lib/tik/img"
#TIK_INSTALL_IMAGE=""

# Deployment-specific settings belong in ${TIK_CUSTOM_DIR}/config.
# A backend accepts --check-secure-boot, or TARGET MIGRATION KEYFILE.
# It must independently protect the running medium before modifying TARGET.
TIK_DEPLOY_COMMAND=""
TIK_SELFDEPLOY_ONLY=0
TIK_DEFER_ROOT_WITHOUT_MIGRATION=0
TIK_LOG_FILE="${HOME}/tik.log"
TIK_INSTALL_MEDIA_LABEL="TIKINSTALL"
TIK_EFI_BOOT_PATH='\EFI\systemd\shim.efi'
TIK_SOURCE_DEVICE_FILE=""
TIK_INTEGRATION_LIBRARY=""

# To show USB devices in the install device selection dialog, uncomment this variable
# USB devices are filtered out by default
#TIK_ALLOW_USB_INSTALL_DEVICES=1

# For unattended installations the disk device to deploy the image must be defined
# Default: Undefined
#TIK_INSTALL_DEVICE=""

# Display name of the OS to be deployed by tik
# Default: Undefined
#TIK_OS_NAME=""

# URL for bug reports to go to
# Default: https://aeondesktop.org/reportbug
TIK_BUG_URL="https://aeondesktop.org/reportbug"
