# Migration needs USER now; without migration the installed initrd performs
# the same provisioning transaction on first boot.

if [[ -z ${tik_keyfile:-} || ! -f ${tik_keyfile} ]]; then
    log "[encrypt] No bootstrap key: root provisioning is deferred or the image does not require encryption setup"
    return 0
fi

prepare_pcrlock_policy() {
    local pcr pcr_json
    local -a pcrs pcr_options=()
    [[ ${TIK_PCRLOCK_PCRS:-} =~ ^[0-9]+(\+[0-9]+)*$ ]] || {
        log '[encrypt] TIK_PCRLOCK_PCRS is missing or invalid'
        return 1
    }
    IFS=+ read -r -a pcrs <<<"${TIK_PCRLOCK_PCRS}"
    for pcr in "${pcrs[@]}"; do
        [[ ${pcr} =~ ^(0|[1-9][0-9]?)$ && ${pcr} -lt 24 ]] || return 1
        pcr_options+=("--pcr=${pcr}")
    done
    pcr_json="[$(IFS=,; echo "${pcrs[*]}")]"
    prun-opt /usr/bin/systemd-machine-id-setup --root="${TIK_ROOT_MNT}"
    [[ ${retval} -eq 0 ]] || return 1

    prun-opt /usr/bin/chroot "${TIK_ROOT_MNT}" \
        /usr/lib/systemd/systemd-pcrlock is-supported
    [[ ${retval} -eq 0 ]] || return 1

    prun-opt /usr/bin/chroot "${TIK_ROOT_MNT}" \
        /usr/lib/systemd/systemd-pcrlock lock-firmware-code
    [[ ${retval} -eq 0 ]] || return 1

    prun-opt /usr/bin/chroot "${TIK_ROOT_MNT}" \
        /usr/lib/systemd/systemd-pcrlock lock-secureboot-policy
    [[ ${retval} -eq 0 ]] || return 1

    prun-opt /usr/bin/chroot "${TIK_ROOT_MNT}" \
        /usr/lib/systemd/systemd-pcrlock lock-secureboot-authority
    [[ ${retval} -eq 0 ]] || return 1

    # systemd 262 added --strict= to predict and make-policy. Until 262 is the
    # minimum version, verify explicitly that configured PCRs were not silently
    # dropped from the generated policy.
    # TODO(systemd>=262): Replace the jq checks with --strict=yes.
    prun-opt /usr/bin/chroot "${TIK_ROOT_MNT}" /usr/bin/bash -c \
        'set -o pipefail
         wanted=$1; shift
         /usr/lib/systemd/systemd-pcrlock --json=short "$@" predict |
             /usr/bin/jq -e --argjson wanted "$wanted" \
                 '\''($wanted - [.[][] | .pcr] | length) == 0'\'' >/dev/null' \
        tik-pcr-policy "${pcr_json}" "${pcr_options[@]}"
    [[ ${retval} -eq 0 ]] || return 1

    prun-opt /usr/bin/chroot "${TIK_ROOT_MNT}" \
        /usr/lib/systemd/systemd-pcrlock make-policy "${pcr_options[@]}"
    [[ ${retval} -eq 0 ]] || return 1

    prun-opt /usr/bin/chroot "${TIK_ROOT_MNT}" /usr/bin/jq -e --argjson wanted "${pcr_json}" \
        '($wanted - [.pcrValues[].pcr] | length) == 0' \
        /var/lib/systemd/pcrlock.json
    [[ ${retval} -eq 0 ]] || return 1

    # Use the same PCR-15 component and credential-publication workaround as
    # first-boot provisioning rather than enrolling an incomplete 0/7 policy.
    if [[ -n ${TIK_PCRLOCK_UPDATE_COMMAND:-} ]]; then
        prun-opt /usr/bin/chroot "${TIK_ROOT_MNT}" "${TIK_PCRLOCK_UPDATE_COMMAND}"
        [[ ${retval} -eq 0 ]] || return 1
    fi
    return 0
}

remove_pcrlock_policy() {
    prun-opt /usr/bin/chroot "${TIK_ROOT_MNT}" \
        /usr/lib/systemd/systemd-pcrlock remove-policy
}

configure_encryption() {
    local pcr_public_key=/run/systemd/tpm2-pcr-public-key.pem
    local pcr_signature=/run/systemd/tpm2-pcr-signature.json
    local pcrlock_policy="${TIK_ROOT_MNT}/var/lib/systemd/pcrlock.json"

    tik_progress_step "Mounting encrypted target" 0
    tik_target_mount "" "required"

    [[ -b "${TIK_CRYPT_PART}" ]] ||
        error "Could not find the encrypted root partition on ${TIK_INSTALL_DEVICE}"

    tik_progress_step "Adding disk-encryption passphrase" 20
    logging=false
    if ! printf '%s' "${TIK_INSTALL_PASSPHRASE}" |
        pkexec /usr/sbin/cryptsetup luksAddKey \
            --key-file="${tik_keyfile}" \
            --new-keyfile=- \
            --force-password \
            "${TIK_CRYPT_PART}"; then
        logging=true
        error "Could not add the disk-encryption passphrase"
    fi
    if ! printf '%s' "${TIK_INSTALL_PASSPHRASE}" |
        pkexec /usr/sbin/cryptsetup open --test-passphrase --key-file=- \
            "${TIK_CRYPT_PART}"; then
        logging=true
        error "Could not verify the disk-encryption passphrase"
    fi
    unset TIK_INSTALL_PASSPHRASE
    logging=true

    if [[ -c /dev/tpmrm0 ]]; then
        tik_progress_step "Binding disk encryption to TPM 2.0" 45
        if [[ ! -r "${pcr_public_key}" || ! -r "${pcr_signature}" ]]; then
            d --warning --no-wrap --title="TPM enrollment unavailable" \
                --text="The booted image does not contain its signed PCR 11 policy. The installation remains accessible with its passphrase."
        else
            if ! prepare_pcrlock_policy; then
                remove_pcrlock_policy
                d --warning --no-wrap --title="TPM policy setup failed" \
                    --text="The installation remains accessible with its passphrase. TPM enrollment can be retried later."
            else
                prun-opt /usr/bin/systemd-cryptenroll \
                    --unlock-key-file="${tik_keyfile}" \
                    --tpm2-device=auto \
                    --tpm2-pcrs= \
                    --tpm2-public-key="${pcr_public_key}" \
                    --tpm2-public-key-pcrs="${TIK_TPM2_PUBLIC_KEY_PCRS:-11}" \
                    --tpm2-signature="${pcr_signature}" \
                    --tpm2-pcrlock="${pcrlock_policy}" \
                    "${TIK_CRYPT_PART}"
                if [[ ${retval} -ne 0 ]]; then
                    remove_pcrlock_policy
                    d --warning --no-wrap --title="TPM enrollment failed" \
                        --text="The installation remains accessible with its passphrase. TPM enrollment can be retried later."
                else
                    prun-opt /usr/sbin/cryptsetup open --test-passphrase \
                        --token-only "${TIK_CRYPT_PART}"
                    if [[ ${retval} -ne 0 ]]; then
                        d --warning --no-wrap --title="TPM unlock test failed" \
                            --text="The installation remains accessible with its passphrase. TPM enrollment can be retried after booting the installed system."
                    fi
                fi
            fi
        fi
    else
        d --warning --no-wrap --title="TPM enrollment unavailable" \
            --text="The installation remains accessible with its passphrase, which will be required at boot."
    fi
}

label_target() {
    local contexts policy selinux_type

    tik_progress_step "Applying SELinux labels" 70
    selinux_type="$(sed -n 's/^SELINUXTYPE=//p' /etc/selinux/config | tail -n1)"
    selinux_type="${selinux_type:-targeted}"
    contexts="/etc/selinux/${selinux_type}/contexts/files/file_contexts"
    policy="$(find "/etc/selinux/${selinux_type}/policy" -maxdepth 1 \
        -type f -name 'policy.*' -print | sort -V | tail -n1)"
    [[ -f "${contexts}" && -f "${policy}" ]] ||
        error "SELinux policy required to label the installation is missing"

    prun /usr/sbin/setfiles -F -c "${policy}" -r "${TIK_ROOT_MNT}" \
        "${contexts}" "${TIK_ROOT_MNT}"
}

configure_encryption
label_target
tik_progress_step "Encryption configured" 100
