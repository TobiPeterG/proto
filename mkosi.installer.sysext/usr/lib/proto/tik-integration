# Proto-specific layout hooks. TIK itself delegates through configured hooks.

tik_partition_by_type() {
    local disk="$1"
    local type="${2,,}"

    lsblk "${disk}" -nrpo PATH,PARTTYPE |
        awk -v wanted="${type}" \
            'tolower($2) == wanted { print $1; exit }'
}

proto_tik_mount_etc() {
    # Existing Proto installations have deployment-specific /etc snapshots.
    # Prefer the last selected version, then the highest version; freshly
    # deployed migration targets still use the bootstrap @etc seed.
    local etc_subvolume="${TIK_ETC_SUBVOLUME:-}" candidate current
    if [[ ${etc_subvolume} == @etc ]]; then
        if ! mountpoint -q "${TIK_ROOT_MNT}/.system"; then
            tik_mount "${TIK_ROOT_DEV}" "${TIK_ROOT_MNT}/.system" \
                "subvol=/,nodev,nosuid" btrfs
        fi
        current="$(readlink "${TIK_ROOT_MNT}/.system/@etc-current" 2>/dev/null || true)"
        if [[ ${current} =~ ^@etc-[A-Za-z0-9][A-Za-z0-9._+-]*$ &&
              -d ${TIK_ROOT_MNT}/.system/${current} ]]; then
            etc_subvolume="${current}"
        else
            candidate="$(
                for current in "${TIK_ROOT_MNT}/.system/"@etc-*; do
                    [[ -d ${current} && ! -L ${current} ]] || continue
                    printf '%s\n' "${current##*/}"
                done | sort -V | tail -n1
            )"
            [[ -z ${candidate} ]] || etc_subvolume="${candidate}"
        fi
    fi
    # Mount it before assembling fstab so the normal TIK helpers see /etc.
    if [ -n "${TIK_ETC_SUBVOLUME:-}" ] &&
        prun-opt /usr/sbin/btrfs subvolume list "${TIK_ROOT_MNT}" |
            awk -v path="${etc_subvolume#/}" '$NF == path { found=1 } END { exit !found }'; then
        tik_mount "${TIK_ROOT_DEV}" "${TIK_ROOT_MNT}/etc" \
            "subvol=/${etc_subvolume#/}" btrfs
    elif [ -n "${TIK_ETC_SUBVOLUME:-}" ]; then
        log "[tik_target_mount] configured /etc subvolume ${TIK_ETC_SUBVOLUME} not found"
    fi

}

proto_tik_mount_filesystems() {
    # A self-deployed target has the exact authenticated /usr currently used
    # by the live system. Bind it into the target so chrooted systemd tools and
    # their libraries are available before the installed system has booted.
    if [[ "${TIK_BIND_LIVE_USR:-0}" == 1 ]] && ! mountpoint -q "${TIK_ROOT_MNT}/usr"; then
        tik_mount /usr "${TIK_ROOT_MNT}/usr" "bind,ro" none
    fi

    # Mount the target's boot partitions explicitly. Proto intentionally has
    # no persistent fstab entries for discoverable GPT partitions, while
    # systemd-pcrlock needs the target XBOOTLDR for its credential.
    TIK_XBOOTLDR_PART="$(tik_partition_by_type "${TIK_INSTALL_DEVICE}" \
        bc13c2ff-59e6-4262-a352-b275fd6f7172)"
    export TIK_XBOOTLDR_PART
    if [[ -n "${TIK_XBOOTLDR_PART}" ]] && ! mountpoint -q "${TIK_ROOT_MNT}/boot"; then
        tik_mount "${TIK_XBOOTLDR_PART}" "${TIK_ROOT_MNT}/boot" "rw" vfat
        log "[tik_target_mount] mounted XBOOTLDR ${TIK_XBOOTLDR_PART}"
    fi

    TIK_ESP_PART="$(tik_partition_by_type "${TIK_INSTALL_DEVICE}" \
        c12a7328-f81f-11d2-ba4b-00a0c93ec93b)"
    export TIK_ESP_PART
    if [[ -n "${TIK_ESP_PART}" ]] && ! mountpoint -q "${TIK_ROOT_MNT}/efi"; then
        tik_mount "${TIK_ESP_PART}" "${TIK_ROOT_MNT}/efi" "rw" vfat
        log "[tik_target_mount] mounted ESP ${TIK_ESP_PART}"
    elif [[ -z "${TIK_ESP_PART}" ]]; then
        log "[tik_target_mount] no ESP found (continuing)"
    fi

}

TIK_TARGET_ROOT_HOOK=proto_tik_mount_etc
TIK_TARGET_MOUNTS_HOOK=proto_tik_mount_filesystems
