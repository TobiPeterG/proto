#!/usr/bin/bash
# SPDX-License-Identifier: MIT
# SPDX-FileCopyrightText: Copyright 2026 Tobias Görgens

set -euo pipefail

remote=https://dl.flathub.org/repo/flathub.flatpakrepo
autostart="${XDG_CONFIG_HOME:-${HOME}/.config}/autostart/proto-enable-flathub.desktop"
# Setup/system accounts must not configure a remote in their temporary homes.
[[ $(id -u) -ge 1000 && $(id -u) -lt 65534 && ${HOME} == /home/* ]] || exit 0

until flatpak remote-add --user --if-not-exists flathub "${remote}" &&
      flatpak update --user --appstream flathub; do
    sleep 60
done
rm -f -- "${autostart}"
