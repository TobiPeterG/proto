set -euo pipefail

pcrlock=/usr/lib/systemd/systemd-pcrlock
policy=/var/lib/systemd/pcrlock.json
component=/var/lib/pcrlock.d/825-cryptsetup-root.pcrlock

[[ -x "${pcrlock}" && -f "${policy}" ]] || exit 0

# systemd-pcrlock does not synthesize a component for the
# volume-key measurement written to PCR 15. Keep the component in /var so it is
# tied to this encrypted installation rather than shipped in the image.
# TODO(systemd#42748): Replace this CEL parsing with the native volume-key lock
# command/component once systemd-pcrlock provides one.
if [[ ! -f "${component}" ]]; then
    digest="$(
        "${pcrlock}" cel |
            jq -er '
                [
                    .[]
                    | select(.content.eventType == "volume-key")
                    | .digests[]
                    | select(.hashAlg == "sha256")
                    | .digest
                ]
                | unique
                | if length == 1 then
                    .[0]
                  else
                    error("expected exactly one SHA-256 volume-key measurement")
                  end
            '
    )"

    install -d -m 0755 /var/lib/pcrlock.d
    temporary="$(mktemp --tmpdir=/var/lib/pcrlock.d .825-cryptsetup-root.XXXXXX)"
    trap 'rm -f "${temporary:-}"' EXIT
    jq -cn --arg digest "${digest}" \
        '{records: [{pcr: 15, digests: [{hashAlg: "sha256", digest: $digest}]}]}' \
        >"${temporary}"
    chmod 0644 "${temporary}"
    mv -f "${temporary}" "${component}"
    trap - EXIT
fi

# systemd 262 added --strict= to predict and make-policy. The explicit jq
# checks retain compatibility with systemd 261 while ensuring none of the
# requested PCRs are silently omitted.
# TODO(systemd>=262): Use --strict=yes and remove both manual PCR-set checks
# once 262 is the minimum supported version.
prediction="$(
    "${pcrlock}" --json=short --pcr=0 --pcr=7 --pcr=15 predict
)"
jq -e \
    'any(.[][]; .pcr == 0) and any(.[][]; .pcr == 7) and any(.[][]; .pcr == 15)' \
    <<<"${prediction}" >/dev/null

"${pcrlock}" make-policy --pcr=0 --pcr=7 --pcr=15

jq -e 'any(.pcrValues[]; .pcr == 0) and any(.pcrValues[]; .pcr == 7) and any(.pcrValues[]; .pcr == 15)' \
    "${policy}" >/dev/null
