[Unit]
Description=Maintain Proto TPM PCR policy
# TODO(systemd#42748): Remove this startup coordinator once a native root
# volume-key component replaces Proto's generated 825 component. Update-time
# policy refresh is already handled by the native Varlink notification socket.
Documentation=man:systemd-pcrlock(8)
ConditionSecurity=measured-uki
ConditionSecurity=uefi-secureboot
ConditionKernelCommandLine=!proto.installer=yes
ConditionPathExists=/var/lib/systemd/pcrlock.json
After=proto-tpm-enroll.service
After=local-fs.target
After=systemd-pcrmachine.service systemd-pcrfs-root.service
After=systemd-pcrlock-firmware-code.service
After=systemd-pcrlock-secureboot-policy.service
After=systemd-pcrlock-secureboot-authority.service
After=systemd-pcrlock-machine-id.service
After=systemd-pcrlock-file-system.service
Wants=systemd-pcrmachine.service systemd-pcrfs-root.service
Requires=systemd-pcrlock-firmware-code.service
Requires=systemd-pcrlock-secureboot-policy.service
Requires=systemd-pcrlock-secureboot-authority.service
Requires=systemd-pcrlock-machine-id.service
Requires=systemd-pcrlock-file-system.service
RequiresMountsFor=/boot /var/lib/pcrlock.d /var/lib/systemd

[Service]
Type=oneshot
ExecStart=/usr/lib/proto-pcrlock-update

[Install]
WantedBy=multi-user.target
