[Unit]
Description=Bind the encrypted proto root to the installed boot measurements
Documentation=man:systemd-cryptenroll(1)
ConditionPathExists=/var/lib/proto/tpm2-rebind-needed
After=local-fs.target systemd-tpm2-setup.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/proto-tpm2-rebind
RemainAfterExit=yes

# A failed rebind must not prevent boot: the passphrase and recovery key remain
# valid, and the marker causes another attempt on the next boot.

[Install]
WantedBy=multi-user.target
