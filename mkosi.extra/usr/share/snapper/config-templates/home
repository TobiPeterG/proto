# Per-user home template, based on KDE Linux's snapper home configuration.
SUBVOLUME=""
FSTYPE="btrfs"

# Space-aware cleanup needs reliable qgroup accounting. Keep it disabled and
# use the bounded timeline below.
QGROUP=""
SPACE_LIMIT="0.1"
FREE_LIMIT="0.4"

ALLOW_USERS=""
ALLOW_GROUPS=""
SYNC_ACL="yes"
BACKGROUND_COMPARISON="no"

# There is no transactional package-manager hook for home directories.
NUMBER_CLEANUP="no"
NUMBER_MIN_AGE="1800"
NUMBER_LIMIT="0"
NUMBER_LIMIT_IMPORTANT="0"

TIMELINE_CREATE="yes"
TIMELINE_CLEANUP="yes"
TIMELINE_MIN_AGE="1800"
TIMELINE_LIMIT_HOURLY="6"
TIMELINE_LIMIT_DAILY="7"
TIMELINE_LIMIT_WEEKLY="4"
TIMELINE_LIMIT_MONTHLY="2"
TIMELINE_LIMIT_QUARTERLY="0"
TIMELINE_LIMIT_YEARLY="0"

EMPTY_PRE_POST_CLEANUP="yes"
EMPTY_PRE_POST_MIN_AGE="1800"
