[Unit]
Description=Recreate proto mutable Btrfs state
DefaultDependencies=no
After=systemd-repart.service systemd-udev-settle.service
Before=factory-reset-now.target systemd-factory-reset-complete.service initrd-root-fs.target sysroot.mount
Conflicts=shutdown.target initrd-switch-root.target

[Service]
Type=oneshot
ExecStart=/usr/lib/proto-factory-reset
