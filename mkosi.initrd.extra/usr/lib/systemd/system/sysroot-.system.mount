[Unit]
Description=Mount the Proto USER filesystem top level
DefaultDependencies=no
ConditionKernelCommandLine=!proto.installer=yes
Requires=sysroot.mount
After=sysroot.mount
Before=proto-etc-prepare.service sysroot-etc.mount initrd-switch-root.target

[Mount]
What=/dev/gpt-auto-root
Where=/sysroot/.system
Type=btrfs
Options=subvol=/,nodev,nosuid,x-gvfs-hide,x-gdu.hide
