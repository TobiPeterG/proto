#!/bin/bash
set -euo pipefail

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin

die() {
    echo "proto factory reset: $*" >&2
    exit 1
}

cmdline_value() {
    local key=$1 word
    for word in $(</proc/cmdline); do
        if [[ ${word} == "${key}="* ]]; then
            printf '%s\n' "${word#*=}"
            return 0
        fi
    done
    return 1
}

hash_uuid() {
    local hash=$1 offset=$2 value=${hash:$offset:32}
    printf '%s-%s-%s-%s-%s\n' \
        "${value:0:8}" "${value:8:4}" "${value:12:4}" \
        "${value:16:4}" "${value:20:12}"
}

delete_subvolume() {
    local path=$1
    [[ -e ${path} ]] || return 0
    btrfs subvolume show "${path}" >/dev/null 2>&1 || \
        die "refusing to remove non-subvolume ${path}"
    btrfs subvolume delete --recursive --commit-after "${path}"
}

usrhash=$(cmdline_value usrhash) || die 'the signed UKI contains no usrhash'
[[ ${usrhash} =~ ^[0-9a-fA-F]{64}$ ]] || die 'the UKI contains an invalid usrhash'
data_uuid=$(hash_uuid "${usrhash,,}" 0)
hash_uuid_value=$(hash_uuid "${usrhash,,}" 32)

udevadm settle --timeout=60
usr_device=/dev/disk/by-partuuid/${data_uuid}
verity_device=/dev/disk/by-partuuid/${hash_uuid_value}
[[ -b ${usr_device} ]] || die "cannot find active /usr partition ${data_uuid}"
[[ -b ${verity_device} ]] || die "cannot find active usr-verity partition ${hash_uuid_value}"

root_device=
for candidate in \
    /dev/gpt-auto-root-ignore-factory-reset \
    /dev/disk/by-designator/root-ignore-factory-reset \
    /dev/gpt-auto-root \
    /dev/disk/by-designator/root; do
    if [[ -b ${candidate} ]]; then
        root_device=$(readlink -f -- "${candidate}")
        break
    fi
done
[[ -n ${root_device} ]] || die 'cannot find the Btrfs USER partition'

work=/run/proto-factory-reset
top=${work}/top
image_root=${work}/usr
mkdir -p "${top}" "${image_root}"
mounted_top=no
mounted_image=no
verity_open=no
mounted_etc=no
cleanup() {
    if [[ ${mounted_etc} == yes ]]; then
        umount "${top}/@root.factory-new/etc" 2>/dev/null || true
    fi
    if [[ ${mounted_image} == yes ]]; then
        umount "${image_root}" 2>/dev/null || true
    fi
    if [[ ${verity_open} == yes ]]; then
        veritysetup close proto-factory-usr 2>/dev/null || true
    fi
    if [[ ${mounted_top} == yes ]]; then
        umount "${top}" 2>/dev/null || true
    fi
}
trap cleanup EXIT

veritysetup open --readonly "${usr_device}" proto-factory-usr \
    "${verity_device}" "${usrhash}"
verity_open=yes
mount -t erofs -o ro /dev/mapper/proto-factory-usr "${image_root}"
mounted_image=yes
[[ -d ${image_root}/share/factory/etc ]] || die 'active /usr has no factory /etc'
[[ -d ${image_root}/lib/proto/installer-root-skeleton ]] || die 'active /usr has no root skeleton'

mount -t btrfs -o subvol=/,rw "${root_device}" "${top}"
mounted_top=yes

# Complete or undo interrupted rename windows before staging a new reset.
for name in @root @etc; do
    if [[ -e ${top}/${name}.factory-old ]]; then
        if [[ -e ${top}/${name} ]]; then
            delete_subvolume "${top}/${name}.factory-old"
        else
            mv "${top}/${name}.factory-old" "${top}/${name}"
        fi
    fi
    delete_subvolume "${top}/${name}.factory-new"
done

btrfs subvolume create "${top}/@root.factory-new"
btrfs subvolume create "${top}/@etc.factory-new"
install -d -m 0755 \
    "${top}/@root.factory-new"/{boot,dev,efi,etc,home,media,mnt,opt,proc,root,run,srv,.system,sys,tmp,usr,var}
cp -a "${image_root}/lib/proto/installer-root-skeleton/." \
    "${top}/@root.factory-new/"
cp -a "${image_root}/share/factory/etc/." "${top}/@etc.factory-new/"

contexts=${top}/@etc.factory-new/selinux/targeted/contexts/files/file_contexts
policy=$(find "${top}/@etc.factory-new/selinux/targeted/policy" \
    -maxdepth 1 -type f -name 'policy.*' -print | sort -V | tail -n1)
[[ -f ${contexts} && -n ${policy} && -f ${policy} ]] || \
    die 'active /usr has no usable SELinux policy'
mount --bind "${top}/@etc.factory-new" "${top}/@root.factory-new/etc"
mounted_etc=yes
setfiles -mF -c "${policy}" -r "${top}/@root.factory-new" \
    "${contexts}" "${top}/@root.factory-new"
umount "${top}/@root.factory-new/etc"
mounted_etc=no

mv "${top}/@root" "${top}/@root.factory-old"
mv "${top}/@etc" "${top}/@etc.factory-old"
mv "${top}/@root.factory-new" "${top}/@root"
mv "${top}/@etc.factory-new" "${top}/@etc"
btrfs subvolume set-default "${top}/@root"
sync -f "${top}"

delete_subvolume "${top}/@root.factory-old"
delete_subvolume "${top}/@etc.factory-old"
# Clean up subvolumes left by pre-A/B installations after the replacement is
# committed. The boot partitions and both physical /usr slot pairs are untouched.
delete_subvolume "${top}/@home"
delete_subvolume "${top}/@var"
delete_subvolume "${top}/@deployments"
sync -f "${top}"
