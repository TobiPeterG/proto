#!/bin/bash
set -euo pipefail

: "${IMAGE_ID:?mkosi did not export IMAGE_ID}"

# systemd-boot derives an automatic UKI entry title from PRETTY_NAME in the
# embedded os-release section. Keep the distribution ID intact for package and
# extension compatibility, but give the product and boot entry their own name.
sed -i \
    -e 's/^NAME=.*/NAME="proto"/' \
    -e 's/^PRETTY_NAME=.*/PRETTY_NAME="Prototype Image System"/' \
    /usr/lib/os-release

# New local users get their own Btrfs home subvolume. A user@.service drop-in
# creates the corresponding per-user Snapper configuration at first login.
if grep -q '^BTRFS_SUBVOLUME_HOME=' /etc/default/useradd; then
    sed -i 's/^BTRFS_SUBVOLUME_HOME=.*/BTRFS_SUBVOLUME_HOME=yes/' \
        /etc/default/useradd
else
    printf '\n# Required for per-user Snapper snapshots.\nBTRFS_SUBVOLUME_HOME=yes\n' \
        >> /etc/default/useradd
fi

# openSUSE keeps the vendor skeleton in /usr/etc/skel. Materialize it in the
# mutable /etc before creating the live user and before taking the factory /etc
# copy used by the installed system.
install -d -m 0755 /etc/skel
cp -a /usr/etc/skel/. /etc/skel/

# The installed system starts from this vendor-owned /etc. It is captured
# before adding any live-only users, autologin, or authorization rules. Future
# deployments can merge or snapshot this tree without baking /etc into the
# deployment root.
rm -rf /usr/share/factory/etc
install -d -m 0755 /usr/share/factory/etc
cp -a /etc/. /usr/share/factory/etc/
rm -f /usr/share/factory/etc/hostname
rm -f /usr/share/factory/etc/ssh/ssh_host_* 2>/dev/null || true
# Snapper owns and rewrites this file. The tmpfiles definition creates it only
# when absent, thereby preserving the list across deployments and rollbacks.
rm -f /usr/share/factory/etc/sysconfig/snapper

# Track the exact vendor-owned content. Future deployments use these hashes to
# update untouched files and preserve administrator changes.
/usr/lib/proto-etc-factory seed /usr/share/factory/etc

if [[ "${IMAGE_ID}" == proto-gnome ]]; then
    # Compile the desktop-specific vendor override supplied by the GNOME
    # ExtraTrees source.
    glib-compile-schemas /usr/share/glib-2.0/schemas
fi
