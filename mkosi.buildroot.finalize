#!/usr/bin/bash
set -euo pipefail

# Bind extensions to one desktop deployment, not Tumbleweed's rolling VERSION_ID.
# Do not sanitize versions: that could give different releases the same level.
case ${IMAGE_ID:?} in
    proto-kde|proto-gnome) ;;
    *) echo "proto: unexpected desktop build-root identity: ${IMAGE_ID}" >&2; exit 1 ;;
esac
level=${IMAGE_ID}-${IMAGE_VERSION:?}
[[ ${level} =~ ^[a-z0-9._-]+$ ]] || {
    echo "proto: invalid sysext compatibility level: ${level}" >&2
    exit 1
}
release=${BUILDROOT:?}/usr/lib/os-release
[[ -s ${release} ]] || {
    echo 'proto: desktop build root has no os-release' >&2
    exit 1
}
sed -i '/^SYSEXT_LEVEL=/d; /^VARIANT=/d; /^VARIANT_ID=/d' "${release}"
printf 'SYSEXT_LEVEL="%s"\n' "${level}" >> "${release}"
case ${IMAGE_ID} in
    proto-kde) printf 'VARIANT="KDE Plasma"\nVARIANT_ID=kde\n' >> "${release}" ;;
    proto-gnome) printf 'VARIANT="GNOME"\nVARIANT_ID=gnome\n' >> "${release}" ;;
esac

install -d -m 0755 "${BUILDROOT}/usr/lib/proto"
printf 'IMAGE_ID=%s\nETC_SUBVOLUME=@etc\n' "${IMAGE_ID}" \
    > "${BUILDROOT}/usr/lib/proto/deployment.env"

