#!/usr/bin/python3
"""Select one source-date epoch for this mkosi invocation, including subimages."""
import json
import os
from pathlib import Path
import sys


def invocation_epoch():
    # Configure hooks run separately for each image, all as children of the
    # same mkosi process. Its Linux process start time gives them one timestamp
    # without a stale file in the source tree or independently sampled clocks.
    # mkosi exposes /proc to these hooks; field 22 is start time in clock ticks.
    fields = Path(f"/proc/{os.getppid()}/stat").read_text().rsplit(") ", 1)[1].split()
    started = int(fields[19]) // os.sysconf("SC_CLK_TCK")
    boot = next(int(line.split()[1]) for line in Path("/proc/stat").read_text().splitlines()
                if line.startswith("btime "))
    return boot + started


def main():
    config = json.load(sys.stdin)
    # Honour --source-date-epoch and SOURCE_DATE_EPOCH for reproducible replays.
    if config.get("SourceDateEpoch") is None:
        config["SourceDateEpoch"] = invocation_epoch()
    print(f'proto: {config["Image"]}: source-date epoch {config["SourceDateEpoch"]}',
          file=sys.stderr)
    json.dump(config, sys.stdout)


if __name__ == "__main__":
    main()
